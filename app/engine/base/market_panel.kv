# The market, see market_panel.py

# The ore of the depot, and what the market pays for it if there is one
<MarketPanel>:
    orientation: 'vertical'
    size_hint: None, None
    size: (dp(600) if root.selling else dp(420)), self.minimum_height
    padding: dp(18), dp(14), dp(18), dp(16)
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: PANEL
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        Color:
            rgba: (*HOME_COLOR, .5)
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(12)
            width: dp(1.2)
    PanelTitle:
        text:
            "MARCHÉ  ·  minerai de l'entrepôt" if root.selling \
            else 'ENTREPÔT  ·  minerai stocké'
    Label:
        text: "L'entrepôt est vide"
        font_size: '14sp'
        color: 1, 1, 1, .4
        size_hint_y: None
        height: dp(30) if root.empty else 0
        opacity: 1 if root.empty else 0
        text_size: self.size
        halign: 'left'
        valign: 'middle'
    ScrollView:
        size_hint_y: None
        # Up to six rows, then it scrolls
        height: min(rows.height, dp(6 * 36 + 5 * 4))
        do_scroll_x: False
        BoxLayout:
            id: rows
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(4)
    Label:
        text:
            'Les missions paient bien mieux que le marché' if root.selling \
            else 'Rechargé dans la soute, il peut être livré au chantier'
        font_size: '12sp'
        color: 1, 1, 1, .4
        size_hint_y: None
        height: dp(18)
        text_size: self.size
        halign: 'left'
        valign: 'middle'
    # The refinery, crushing the rock into what little it holds
    BoxLayout:
        size_hint_y: None
        height: dp(36) if root.refinery else 0
        opacity: 1 if root.refinery else 0
        disabled: not root.refinery
        spacing: dp(10)
        Label:
            text:
                f'Raffinerie  ·  concassage, {root.rock} roches' \
                if root.crushing else \
                f'Raffinerie  ·  {root.refinery_told}'
            font_size: '13sp'
            color: 1, 1, 1, .7
            text_size: self.size
            halign: 'left'
            valign: 'middle'
        PanelButton:
            text: 'Concassage…' if root.crushing else 'Concasser la roche'
            bold: False
            font_size: '13sp'
            corner: 8
            glow: .5
            size_hint_x: None
            width: dp(150)
            disabled: root.crushing or not root.rock
            opacity: 1 if root.crushing or root.rock else .4
            on_release: root.crush()
    BoxLayout:
        size_hint_y: None
        height: dp(40)
        spacing: dp(20)
        Label:
            text: f'Crédits  {root.money}' if root.selling else ''
            font_size: '15sp'
            bold: True
            color: (*MONEY_COLOR, 1)
            text_size: self.size
            halign: 'left'
            valign: 'middle'
        PanelButton:
            text: 'Navettes'
            font_size: '15sp'
            size_hint_x: None
            width: dp(120) if root.shuttles else 0
            opacity: 1 if root.shuttles else 0
            disabled: not root.shuttles
            on_release: root.dispatch('on_dock')
        PanelButton:
            text: 'Fermer'
            font_size: '15sp'
            on_release: root.dispatch('on_close')

<OreRow>:
    size_hint_y: None
    height: dp(36)
    padding: dp(8), dp(3)
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: 1, 1, 1, .05
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
    Image:
        source: root.icon
        size_hint_x: None
        width: dp(18)
        fit_mode: 'contain'
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: root.name
            font_size: '14sp'
            text_size: self.size
            halign: 'left'
            valign: 'middle'
        Label:
            text: root.wanted
            font_size: '11sp'
            color: (*MONEY_COLOR, .9)
            size_hint_y: None
            height: dp(12) if root.wanted else 0
            text_size: self.size
            halign: 'left'
            valign: 'middle'
    Label:
        text: root.units
        font_size: '14sp'
        bold: True
        # As wide as it needs, the depot holds no end of ore
        size_hint_x: None
        width: max(dp(40), self.texture_size[0])
    # What the market pays, if there is one
    BoxLayout:
        size_hint_x: None
        width: self.minimum_width if root.selling else 0
        opacity: 1 if root.selling else 0
        disabled: not root.selling
        spacing: dp(10)
        Label:
            text: root.price
            font_size: '12sp'
            color: (*MONEY_COLOR, 1)
            size_hint_x: None
            width: dp(64)
            text_size: self.size
            halign: 'right'
            valign: 'middle'
        PanelButton:
            text: root.batch
            bold: False
            font_size: '12sp'
            corner: 8
            glow: .5
            size_hint_x: None
            width: dp(84)
            opacity: 1 if root.can_batch else 0
            disabled: not root.can_batch
            on_release: root.panel.sell(root.mineral, root.batch_units)
        PanelButton:
            text: 'Tout vendre'
            bold: False
            font_size: '12sp'
            corner: 8
            glow: .5
            size_hint_x: None
            width: dp(92)
            on_release: root.panel.sell(root.mineral)
    PanelButton:
        text: 'Charger'
        bold: False
        font_size: '12sp'
        corner: 8
        glow: .5 if root.can_load else .15
        size_hint_x: None
        width: dp(72)
        disabled: not root.can_load
        on_release: root.panel.load(root.mineral)
