# The base on the Earth, see earth_base.py

# Shown while the ship is landed on the Earth
<EarthBase>:
    # Centered with the scanner and map buttons ending the row, or the map
    # one alone
    row_shift: -.5 if self.full_row else 0
    # Nothing but the open panel shows, besides the cargo
    shown: root.docked and not root.panel

    # What was unloaded on the Earth, shown there
    CargoPanel:
        id: depot
        title: 'ENTREPÔT'
        bar: False
        right: root.right - dp(16)
        y: root.top - dp(16) - self.height
        # Even behind the panels of the base
        opacity: 1 if root.docked else 0

    Label:
        id: money_label
        text: root.money
        font_size: '15sp'
        bold: True
        color: (*MONEY_COLOR, 1)
        size: self.texture_size
        # From the size, which is known once the text is drawn
        x: root.ids.depot.right - dp(14) - self.width
        y: root.ids.depot.y - dp(8) - self.height
        opacity: 1 if root.docked else 0

    # Where the landing shortcut was, once landed
    BaseButton:
        id: unload_button
        text:
            'Entrepôt plein' if root.depot_full else \
            'Déchargement…' if root.unloading else 'Décharger'
        glow: .9 if root.can_unload else .3
        x:
            root.center_x - self.width / 2 \
            + dp(ROW_BUTTON + ROW_GAP) * (-2 + root.row_shift)
        disabled: not root.can_unload or not root.shown
        on_release: root.unload()

    BaseButton:
        id: market_button
        text: 'Entrepôt'
        glow: .6
        x:
            root.center_x - self.width / 2 \
            + dp(ROW_BUTTON + ROW_GAP) * (-1 + root.row_shift)
        disabled: not root.shown
        on_release: root.open('market')

    BaseButton:
        id: missions_button
        text: 'Missions'
        # Brighter when one of them can be validated
        glow: .95 if root.to_validate else .6
        color: (*MONEY_COLOR, 1) if root.to_validate else (1, 1, 1, 1)
        x:
            root.center_x - self.width / 2 \
            + dp(ROW_BUTTON + ROW_GAP) * (0 + root.row_shift)
        disabled: not root.shown
        on_release: root.open('missions')

    BaseButton:
        id: hangar_button
        text: 'Hangar'
        # Brighter when new parts are sold
        glow: .95 if root.new_parts else .6
        color: (*MONEY_COLOR, 1) if root.new_parts else (1, 1, 1, 1)
        x:
            root.center_x - self.width / 2 \
            + dp(ROW_BUTTON + ROW_GAP) * (1 + root.row_shift)
        disabled: not root.shown
        on_release: root.open('hangar')

    Layer:
        size: root.size
        pos: root.pos
        shown: root.panel == 'hangar'
        HangarPanel:
            id: hangar
            # From the height, which is known once the rows are in
            x: root.center_x - self.width / 2
            y: root.center_y - self.height / 2
            on_close: root.close()

    Layer:
        size: root.size
        pos: root.pos
        shown: root.panel == 'market'
        MarketPanel:
            id: market
            x: root.center_x - self.width / 2
            y: root.center_y - self.height / 2
            on_close: root.close()

    Layer:
        size: root.size
        pos: root.pos
        shown: root.panel == 'missions'
        MissionsPanel:
            id: missions
            x: root.center_x - self.width / 2
            y: root.center_y - self.height / 2
            on_close: root.close()

# In the row at the bottom, the scanner button of the game ending it
<BaseButton@PanelButton>:
    font_size: '17sp'
    size_hint: None, None
    size: dp(ROW_BUTTON), dp(48)
    y: self.parent.y + dp(ROW_BOTTOM) if self.parent else 0
    opacity: 1 if self.parent and self.parent.shown else 0
