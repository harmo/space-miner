# An outpost, see outpost_view.py

# Shown while the ship is parked on the pad of an outpost
<OutpostView>:
    shown: root.docked and not root.panel
    # As those of the base on the Earth, the scanner and map ending the row
    row_shift: -.5 if self.full_row else 0
    slot_width: dp(ROW_BUTTON + ROW_GAP)

    # What was unloaded there, once it has a depot
    CargoPanel:
        id: depot
        title: 'ENTREPÔT'
        bar: False
        right: root.right - dp(16)
        y: root.top - dp(16) - self.height
        opacity: 1 if root.docked and root.has_depot else 0

    Label:
        id: money_label
        text: root.money
        font_size: '15sp'
        bold: True
        color: (*MONEY_COLOR, 1)
        size: self.texture_size
        x: root.right - dp(30) - self.width
        y:
            (root.ids.depot.y if root.has_depot \
            else root.top - dp(8)) - dp(8) - self.height
        opacity: 1 if root.docked else 0

    # Where the landing shortcut was, once landed
    BaseButton:
        id: site_button
        text: 'Chantier'
        glow: .9
        color: (*OUTPOST_COLOR, 1)
        x:
            root.center_x - self.width / 2 \
            + root.slot_width * (root.site_slot + root.row_shift)
        opacity: 1 if root.shown and root.building else 0
        disabled: not root.shown or not root.building
        on_release: root.open('site')

    BaseButton:
        id: unload_button
        text: 'Déchargement…' if root.unloading else 'Décharger'
        glow: .9 if root.can_unload else .3
        x:
            root.center_x - self.width / 2 \
            + root.slot_width * (root.unload_slot + root.row_shift)
        opacity: 1 if root.shown and root.has_depot else 0
        disabled: not root.shown or not root.can_unload
        on_release: root.unload()

    BaseButton:
        id: market_button
        text: 'Marché'
        glow: .6
        x:
            root.center_x - self.width / 2 \
            + root.slot_width * (root.market_slot + root.row_shift)
        opacity: 1 if root.shown and root.has_market else 0
        disabled: not root.shown or not root.has_market
        on_release: root.open('market')

    BaseButton:
        id: missions_button
        text: 'Missions'
        glow: .95 if root.to_validate else .6
        color: (*MONEY_COLOR, 1) if root.to_validate else (1, 1, 1, 1)
        x:
            root.center_x - self.width / 2 \
            + root.slot_width * (root.missions_slot + root.row_shift)
        opacity: 1 if root.shown and root.has_missions else 0
        disabled: not root.shown or not root.has_missions
        on_release: root.open('missions')

    Layer:
        size: root.size
        pos: root.pos
        shown: root.panel == 'market'
        MarketPanel:
            id: market
            x: root.center_x - self.width / 2
            y: root.center_y - self.height / 2
            on_close: root.close()

    Layer:
        size: root.size
        pos: root.pos
        shown: root.panel == 'missions'
        MissionsPanel:
            id: missions
            x: root.center_x - self.width / 2
            y: root.center_y - self.height / 2
            on_close: root.close()

    Layer:
        size: root.size
        pos: root.pos
        shown: root.panel == 'site'
        SitePanel:
            id: site
            view: root
            x: root.center_x - self.width / 2
            y: root.center_y - self.height / 2

# What the stage being built needs, and what was delivered
<SitePanel>:
    orientation: 'vertical'
    size_hint: None, None
    size: dp(440), self.minimum_height
    padding: dp(20), dp(14), dp(20), dp(16)
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: PANEL
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        Color:
            rgba: (*OUTPOST_COLOR, .5)
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(12)
            width: dp(1.2)
    PanelTitle:
        text: root.title
    Label:
        text: root.stage
        font_size: '17sp'
        bold: True
        size_hint_y: None
        height: dp(28)
        text_size: self.size
        halign: 'left'
        valign: 'middle'
    Label:
        text: root.news
        font_size: '14sp'
        bold: True
        color: (*MET_COLOR, 1)
        size_hint_y: None
        height: dp(22) if root.news else 0
        opacity: 1 if root.news else 0
        text_size: self.size
        halign: 'left'
        valign: 'middle'
    BoxLayout:
        id: rows
        orientation: 'vertical'
        size_hint_y: None
        height: self.minimum_height
        spacing: dp(4)
    Label:
        text: root.adds
        font_size: '13sp'
        color: (*OUTPOST_COLOR, .9)
        size_hint_y: None
        height: dp(22) if root.adds else 0
        text_size: self.size
        halign: 'left'
        valign: 'middle'
    BoxLayout:
        size_hint_y: None
        height: dp(42)
        spacing: dp(10)
        PanelButton:
            text: 'Livrer'
            font_size: '15sp'
            glow: .9 if root.can_deliver else .2
            disabled: not root.can_deliver
            on_release: root.view.deliver()
        PanelButton:
            text: 'Fermer'
            font_size: '15sp'
            on_release: root.view.close()

# Delivered, needed, and what the cargo holds of it
<SupplyRow>:
    size_hint_y: None
    height: dp(30)
    spacing: dp(10)
    Image:
        source: root.icon
        size_hint_x: None
        width: dp(18)
        fit_mode: 'contain'
    Label:
        text: root.name
        font_size: '15sp'
        color: (*MET_COLOR, 1) if root.met else (1, 1, 1, .85)
        text_size: self.size
        halign: 'left'
        valign: 'middle'
    Label:
        text: root.held
        font_size: '12sp'
        color: 1, 1, 1, .5
        size_hint_x: None
        width: dp(70)
        text_size: self.size
        halign: 'right'
        valign: 'middle'
    Label:
        text: root.progress
        font_size: '15sp'
        bold: root.met
        color: (*MET_COLOR, 1) if root.met else (1, 1, 1, 1)
        size_hint_x: None
        width: dp(90)
        text_size: self.size
        halign: 'right'
        valign: 'middle'
