# The home page, see home_page.py

#:set HELP 'Maintenir pour piloter   ·   Toucher un astéroïde pour le miner'

<HomePage>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, .6
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        size_hint: None, None
        width: dp(460)
        height: self.minimum_height
        spacing: dp(8) if root.compact else dp(14)
        center_x: root.center_x
        # From the height, which is known once the rows are in
        y: root.y + root.height * .55 - self.height / 2
        # Behind the settings
        opacity: 0 if root.settings_open else 1
        disabled: root.settings_open
        Label:
            text: 'SPACE MINER'
            bold: True
            font_size: '44sp' if root.compact else '64sp'
            size_hint_y: None
            height: self.texture_size[1]
        Label:
            text: 'Minage dans le système solaire'
            font_size: '18sp'
            color: 1, 1, 1, .6
            size_hint_y: None
            height: self.texture_size[1]
        Widget:
            size_hint_y: None
            height: dp(8) if root.compact else dp(26)
        PanelButton:
            text: 'Reprendre' if root.paused else 'Jouer'
            font_size: '20sp'
            glow: .9
            size_hint: None, None
            size: dp(220), dp(54)
            pos_hint: {'center_x': .5}
            on_release: root.dispatch('on_play')
        PanelButton:
            text: 'Réglages'
            font_size: '17sp'
            size_hint: None, None
            size: dp(220), dp(48)
            pos_hint: {'center_x': .5}
            on_release: root.dispatch('on_settings')
        # Phones close apps from the system
        PanelButton:
            text: 'Quitter'
            font_size: '17sp'
            size_hint: None, None
            size: dp(220), dp(48) if not root.mobile else 0
            pos_hint: {'center_x': .5}
            opacity: 0 if root.mobile else 1
            disabled: root.mobile
            on_release: app.stop()
        Widget:
            size_hint_y: None
            height: dp(4) if root.compact else dp(18)
        Label:
            text: HELP
            font_size: '14sp'
            color: 1, 1, 1, .5
            size_hint_y: None
            height: self.texture_size[1]
