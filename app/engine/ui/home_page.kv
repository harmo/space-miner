# The home page, see home_page.py

#:set HELP 'Maintenir pour piloter   ·   Toucher un astéroïde pour le miner'

# A game saved, or a place for one: to play it, or to erase it
<SlotCard>:
    orientation: 'vertical'
    spacing: dp(4)
    PanelButton:
        text: root.text
        font_size: '13sp'
        bold: False
        halign: 'center'
        glow: .9 if root.current else .4
        on_release: root.home.dispatch('on_slot', root.slot)
    PanelButton:
        text: 'Confirmer' if root.confirming else 'Effacer'
        font_size: '12sp'
        bold: False
        corner: 8
        glow: .9 if root.confirming else .2
        color: (1, .55, .5, 1) if root.confirming else (1, 1, 1, .6)
        size_hint_y: None
        height: dp(26)
        opacity: 1 if root.filled else 0
        disabled: not root.filled
        on_release: root.home.erase(root)

<HomePage>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, .6
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        size_hint: None, None
        width: dp(660)
        height: self.minimum_height
        spacing: dp(8) if root.compact else dp(14)
        center_x: root.center_x
        # From the height, which is known once the rows are in
        y: root.y + root.height * .55 - self.height / 2
        # Behind the settings
        opacity: 0 if root.settings_open else 1
        disabled: root.settings_open
        Label:
            text: 'SPACE MINER'
            bold: True
            font_size: '44sp' if root.compact else '64sp'
            size_hint_y: None
            height: self.texture_size[1]
        Widget:
            size_hint_y: None
            height: dp(2) if root.compact else dp(18)
        BoxLayout:
            id: slots
            size_hint_y: None
            height: dp(100) if root.compact else dp(116)
            spacing: dp(10)
        # A game to get back to, the slots starting the others
        PanelButton:
            text: 'Reprendre'
            font_size: '20sp'
            glow: .9
            size_hint: None, None
            size: dp(220), (dp(54) if root.paused else 0)
            pos_hint: {'center_x': .5}
            opacity: 1 if root.paused else 0
            disabled: not root.paused
            on_release: root.dispatch('on_play')
        PanelButton:
            text: 'Réglages'
            font_size: '17sp'
            size_hint: None, None
            size: dp(220), dp(48)
            pos_hint: {'center_x': .5}
            on_release: root.dispatch('on_settings')
        # Phones close apps from the system
        PanelButton:
            text: 'Quitter'
            font_size: '17sp'
            size_hint: None, None
            size: dp(220), dp(48) if not root.mobile else 0
            pos_hint: {'center_x': .5}
            opacity: 0 if root.mobile else 1
            disabled: root.mobile
            on_release: app.stop()
        Widget:
            size_hint_y: None
            height: dp(4) if root.compact else dp(18)
        Label:
            text: HELP
            font_size: '14sp'
            color: 1, 1, 1, .5
            size_hint_y: None
            height: self.texture_size[1]
