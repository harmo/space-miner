# The cargo, see cargo_panel.py

<CargoPanel>:
    orientation: 'vertical'
    size_hint: None, None
    width: dp(200)
    height: self.minimum_height
    padding: dp(14), dp(10), dp(14), dp(12)
    spacing: dp(2)
    canvas.before:
        Color:
            rgba: PANEL
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
        Color:
            rgba: 1, 1, 1, .1
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(10)
            width: 1
    BoxLayout:
        size_hint_y: None
        height: dp(22)
        Label:
            text: root.title
            bold: True
            font_size: '12sp'
            color: 1, 1, 1, .5
            text_size: self.size
            halign: 'left'
            valign: 'middle'
        Label:
            text: root.load
            font_size: '12sp'
            color: 1, 1, 1, .7
            text_size: self.size
            halign: 'right'
            valign: 'middle'
    # Load of the cargo
    Widget:
        size_hint_y: None
        height: dp(12) if root.bar else 0
        opacity: 1 if root.bar else 0
        canvas:
            Color:
                rgba: 1, 1, 1, .12
            RoundedRectangle:
                pos: self.x, self.y + dp(3)
                size: self.width, dp(5)
                radius: [dp(2.5)]
            Color:
                rgba: (*root.bar_color, .9)
            RoundedRectangle:
                pos: self.x, self.y + dp(3)
                size: self.width * root.fill, dp(5)
                radius: [dp(2.5)]
    Label:
        id: empty
        line: dp(26)
        text: 'Vide'
        font_size: '15sp'
        color: 1, 1, 1, .4
        size_hint_y: None
        height: self.line
        text_size: self.size
        halign: 'left'
        valign: 'middle'

# In the color of its mineral while being mined
<CargoRow>:
    size_hint_y: None
    height: dp(26)
    spacing: dp(10)
    Image:
        source: root.icon
        size_hint_x: None
        width: dp(18)
        fit_mode: 'contain'
    Label:
        text: root.name
        font_size: '15sp'
        color: (*root.color, 1) if root.mining else (1, 1, 1, .85)
        text_size: self.size
        halign: 'left'
        valign: 'middle'
    Label:
        text: str(int(root.amount))
        font_size: '15sp'
        bold: root.mining
        color: 1, 1, 1, 1
        # As wide as it needs, the depot holds no end of ore
        size_hint_x: None
        width: max(dp(44), self.texture_size[0])
