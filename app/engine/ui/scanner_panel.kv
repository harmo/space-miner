# The scanner, see scanner_panel.py

<ScannerPanel>:
    orientation: 'vertical'
    size_hint: None, None
    size: dp(440), self.minimum_height
    padding: dp(18), dp(12), dp(18), dp(14)
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: PANEL
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        Color:
            rgba: (*HOME_COLOR, .5)
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(12)
            width: dp(1.2)
    BoxLayout:
        size_hint_y: None
        height: dp(22)
        PanelTitle:
            text: 'SCANNER'
        Label:
            text: root.reach
            font_size: '13sp'
            color: 1, 1, 1, .7
            text_size: self.size
            halign: 'right'
            valign: 'middle'
    Label:
        text: 'Toucher un minerai pour le chercher, ou non'
        font_size: '12sp'
        color: 1, 1, 1, .45
        size_hint_y: None
        height: dp(16)
        text_size: self.size
        halign: 'left'
        valign: 'middle'
    GridLayout:
        id: rows
        cols: 2
        size_hint_y: None
        height: self.minimum_height
        spacing: dp(4)
        row_default_height: dp(30)
        row_force_default: True
    BoxLayout:
        size_hint_y: None
        height: dp(38)
        spacing: dp(8)
        PanelButton:
            text: 'Tout'
            font_size: '13sp'
            bold: False
            corner: 8
            on_release: root.everything()
        PanelButton:
            text: 'Aucun'
            font_size: '13sp'
            bold: False
            corner: 8
            on_release: root.nothing()
        PanelButton:
            text: 'Missions'
            font_size: '13sp'
            bold: False
            corner: 8
            color: (*MONEY_COLOR, 1)
            on_release: root.for_missions()
        PanelButton:
            text: 'Fermer'
            font_size: '13sp'
            corner: 8
            on_release: root.open = False

# Bright when looked for, with how many are within reach
<ScanRow>:
    padding: dp(8), 0
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: (*root.color, .22) if root.looked_for else (1, 1, 1, .04)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(6)]
    Image:
        source: root.icon
        size_hint_x: None
        width: dp(16)
        fit_mode: 'contain'
        opacity: 1 if root.looked_for else .4
    Label:
        text: root.name
        font_size: '13sp'
        color: (1, 1, 1, 1) if root.looked_for else (1, 1, 1, .45)
        text_size: self.size
        halign: 'left'
        valign: 'middle'
        shorten: True
    Label:
        text: str(root.count) if root.count else '·'
        font_size: '13sp'
        bold: root.looked_for and root.count > 0
        color: (1, 1, 1, .9) if root.count else (1, 1, 1, .3)
        size_hint_x: None
        width: dp(30)
        text_size: self.size
        halign: 'right'
        valign: 'middle'
