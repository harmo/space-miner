# The settings, see preferences_panel.py

# Settings, over the home page
<PreferencesPanel>:
    orientation: 'vertical'
    size_hint: None, None
    size: dp(420), self.minimum_height
    padding: dp(20), dp(14), dp(20), dp(16)
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: PANEL
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        Color:
            rgba: (*HOME_COLOR, .5)
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(12)
            width: dp(1.2)
    PanelTitle:
        text: 'RÉGLAGES'
    SettingRow:
        label: 'Orbites des planètes'
        on: root.orbits
        panel: root
        name: 'orbits'
    SettingRow:
        label: "Repères au bord de l'écran"
        on: root.markers
        panel: root
        name: 'markers'
    # Phones are always full screen
    SettingRow:
        label: 'Plein écran'
        on: root.fullscreen
        height: 0 if root.mobile else dp(40)
        opacity: 0 if root.mobile else 1
        disabled: root.mobile
        panel: root
        name: 'fullscreen'
    VolumeRow:
        label: 'Sons'
        volume: root.sounds
        panel: root
        name: 'sounds'
    VolumeRow:
        label: 'Ambiance'
        volume: root.ambience
        panel: root
        name: 'ambience'
    Widget:
        size_hint_y: None
        height: dp(10)
    PanelButton:
        text: 'Fermer'
        font_size: '15sp'
        size_hint_y: None
        height: dp(42)
        on_release: root.dispatch('on_close')

<SettingRow@BoxLayout>:
    label: ''
    on: False
    size_hint_y: None
    height: dp(40)
    spacing: dp(10)
    panel: None
    name: ''
    Label:
        text: root.label
        font_size: '15sp'
        text_size: self.size
        halign: 'left'
        valign: 'middle'
    PanelButton:
        text: 'Oui' if root.on else 'Non'
        font_size: '14sp'
        corner: 8
        glow: .8 if root.on else .2
        color: (1, 1, 1, 1) if root.on else (1, 1, 1, .5)
        size_hint_x: None
        width: dp(80)
        on_release: root.panel.toggle(root.name)

# A volume, from silent to full, by steps of a tenth
<VolumeRow@BoxLayout>:
    label: ''
    volume: 1.
    size_hint_y: None
    height: dp(40)
    spacing: dp(10)
    panel: None
    name: ''
    Label:
        text: root.label
        font_size: '15sp'
        text_size: self.size
        halign: 'left'
        valign: 'middle'
    Slider:
        min: 0
        max: 1
        step: .1
        value: root.volume
        value_track: True
        value_track_color: (*HOME_COLOR, 1)
        size_hint_x: None
        width: dp(150)
        # Set at first by the panel, not there yet
        on_value:
            root.panel and root.panel.adjust(root.name, round(self.value, 1))
    Label:
        text: f'{round(root.volume * 100)} %' if root.volume else 'Coupé'
        font_size: '14sp'
        color: (1, 1, 1, 1) if root.volume else (1, 1, 1, .5)
        size_hint_x: None
        width: dp(60)
